{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@auth/*": ["./apps/user-service/src/auth/*"],
      "@common/*": ["./apps/user-service/src/common/*"],
      "@configs/*": ["./apps/user-service/src/configs/*"],
      "@features/*": ["./apps/user-service/src/features/*"],
      "@generated/*": ["./apps/user-service/src/generated/*"],
      "@providers/*": ["./apps/user-service/src/providers/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
