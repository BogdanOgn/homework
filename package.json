  "scripts": {
    "build": "nest build --all",
    "start:dev": "concurrently -n user,notification \"npm:start:dev:user\" \"npm:start:dev:notification\"",
    "start:dev:user": "nest start user-service --watch",
    "start:dev:notification": "nest start notification-service --watch",
    "start:debug:user": "nest start user-service --watch --debug 9229",
    "start:debug:notification": "nest start notification-service --watch --debug 9230",
    "start:prod:user": "node dist/apps/user-service/main.js",
    "start:prod:notification": "node dist/apps/notification-service/main.js",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
